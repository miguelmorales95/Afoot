# ---- Supabase ----
# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The service role key is SERVER-ONLY. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The anon/public key powers client-side auth + RSVPs (safe to expose; RLS protects data).
# Required for sign-in. Without it the app runs in "demo auth" mode (simulated sign-in).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Sign-in: enable Google/Facebook in Supabase Dashboard -> Authentication -> Providers,
# and add <your-site>/auth/callback to the allowed redirect URLs.

# ---- LLM provider (event extraction + venue discovery) ----
# "anthropic" (Claude, best quality) or "ollama" (local, free — great for
# leaving the discovery crawler running for hours).
LLM_PROVIDER=anthropic

# Anthropic (used when LLM_PROVIDER=anthropic). From console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Cheap + good enough for structured extraction at scale. Bump to
# claude-sonnet-5-5 if you see date/recurrence mistakes.
EXTRACTION_MODEL=claude-haiku-5-5

# Ollama (used when LLM_PROVIDER=ollama). Install from ollama.com, then e.g.
#   ollama pull llama3.1
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- Web search (venue discovery crawler) ----
# Optional: a Brave Search API key (free tier ~2k/mo) makes discovery more
# reliable. Leave unset to use keyless DuckDuckGo HTML search.
# BRAVE_API_KEY=

# ---- Demo mode ----
# When set to "1", /api/events serves built-in sample LA events so you can see
# the design with no Supabase/keys. Auto-on if Supabase isn't configured.
# DEMO_MODE=1

# ---- Geocoding (OpenStreetMap Nominatim, free, no key) ----
# Nominatim's usage policy requires a real contact email in the User-Agent.
NOMINATIM_EMAIL=you@example.com

# ---- Public contact ----
# Shown in the "email us a venue" button (safe to expose; it's public).
NEXT_PUBLIC_SUGGEST_EMAIL=hello@your-domain.example (leave unset until the domain is bought)

# ---- Ads (privacy-first, cookieless, side rail only) ----
# "house" (self-sold sponsor cards, no tracking — default),
# "ethicalads" (contextual, cookieless — recommended network),
# "adsense" (works but TRACKS users), or "none".
NEXT_PUBLIC_AD_PROVIDER=house
# For ethicalads:
# NEXT_PUBLIC_ETHICALADS_PUBLISHER=your-publisher-id
# For adsense (tracks users — only if you accept that):
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_ADSENSE_SLOT_RAIL=1234567890

# ---- Scheduled ingestion ----
# Any random string; protects /api/cron/ingest from being triggered by randoms.
CRON_SECRET=change-me-to-a-long-random-string

# ---- Admin review page (/admin) ----
# Gate for the submission/candidate review queue. If unset, /admin is open
# (fine locally). Set a long random string in production.
ADMIN_TOKEN=change-me-admin

# ---- Event feedback (flags, heads-up tips, yes/no checks) ----
# Random secret used to hash anonymous browser ids. Server only; set once and keep it,
# or past feedback stops matching the same devices. e.g. `openssl rand -base64 32`
DEVICE_HASH_SALT=change-me-to-a-long-random-string

# ---- Local events file ----
# Serve the feed from a CSV instead of the database (feedback is off in this mode).
# LOCAL_EVENTS_FILE=data/events.csv

# ---- Headless rendering (JS-heavy sites like Zebulon) ----
# Auto-used when a plain fetch comes back thin. Set to 0 to disable.
# Requires: npm i -D playwright && npx playwright install chromium
ENABLE_RENDER=1

# ---- Newsletter ingestion ----
# Protects the inbound webhook (/api/inbound-email). Also set this on your
# email provider's parse hook.
INBOUND_EMAIL_SECRET=change-me-too

# IMAP poller (npm run newsletters): a dedicated inbox you subscribe to venue
# newsletters. For Gmail, use an App Password (not your login password).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_TLS=1
IMAP_USER=afoot.inbox@example.com
IMAP_PASSWORD=your-app-password
